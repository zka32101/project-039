rules_version = '2';

// あんしんみち Firestoreセキュリティルール（ドラフト）。
// 【重要】このセッションはFirebaseプロジェクトへのネットワークアクセスが無いため、
// `firebase emulators:exec` 等での実検証は行えていない。デプロイ前に必ずローカル/CIで検証すること。
//
// 設計方針:
//  - RoadSegment(道路網ジオメトリ含む) / shadeSpots / brightnessSpots は誰でも閲覧可（地図表示に必要）
//  - 投稿の作成は匿名認証済みユーザーであれば可能
//  - 本人確認済みユーザーのみコメント投稿可（isVerifiedUser()参照）。判定はAuth Custom Claim
//    （`request.auth.token.isVerified`）のみで行う。Firestoreドキュメントを都度get()すると
//    ルール評価ごとに追加の読み取り課金・レイテンシが発生するため、Cloud Functions
//    （`syncVerificationStatus`）がFirestore書き込みと同時にCustom Claimも設定する構成にしている。
//  - status/moderationStatus等のモデレーション結果フィールドは、作成時は常に'pending'固定を要求し、
//    'approved'/'rejected'への遷移はCloud Functions（Admin SDK、本ルールの制約を受けない）のみが行う
//    （クライアントが自己承認できてしまう抜け道を塞ぐ）
//  - users/{uid}.isVerifiedも同様にクライアントから直接書き込めない
//    （Cloud Functions `syncVerificationStatus` がID Tokenのphone_numberクレームを検証して書き込む）
service cloud.firestore {
  match /databases/{database}/documents {

    // Custom Claimはトークン発行時点のスナップショットのため、本人確認直後は
    // クライアント側で`getIdToken(true)`による強制リフレッシュが必要
    // （`firebase_verification_service.dart`の`_linkAndSync`参照）。
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.isVerified == true;
    }

    // 道路網ジオメトリ・スコア（Cloud Functionsのシード/バッチ処理のみが書き込む）
    match /roadNodes/{nodeId} {
      allow read: if true;
      allow write: if false;
    }
    match /roadWays/{wayId} {
      allow read: if true;
      allow write: if false;
    }
    match /roadSegments/{segmentId} {
      allow read: if true;
      allow write: if false; // baseShadowScore(バッチ)・aggregated*Score(モデレーション承認時)ともにCloud Functionsのみ
    }
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    match /shadeSpots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['tree', 'arcade', 'rain_shelter'];
      // 'pending'→'approved'等の遷移・投票数の変更はCloud Functions（モデレーション）のみが行う
      allow update, delete: if false;
    }

    match /brightnessSpots/{spotId} {
      allow read: if true;
      // reasonTypeは「夜の明るさ」('dark')と「人通りが少ない」('low_foot_traffic')投稿を区別する。
      // 'low_foot_traffic'は主観的・偏見の影響を受けやすい投稿種別のため、Cloud Functions
      // （handleSpotCreated）が地域のモデレーション設定に関わらず常に人力承認へ回す（荒らし対策）。
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.brightnessLevel in ['dark', 'normal', 'bright']
        && request.resource.data.reasonType in ['dark', 'low_foot_traffic'];
      allow update, delete: if false;
    }

    match /spotComments/{commentId} {
      allow read: if true;
      // 本人確認済みユーザーのみコメント可（設計書要件）。moderationStatusはNGワード判定前提のため
      // 作成時は常に'pending'固定（判定結果の書き込みはCloud Functions側）。
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && isVerifiedUser();
      allow update, delete: if false;
    }

    // 本人確認状態。isVerified/verificationMethodはCloud Functions
    // （syncVerificationStatus）のみが書き込む。本人は自分の状態のみ閲覧可。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // モデレーション設定（地域別の反映モード等）。運用者のみが管理コンソール等で更新する想定
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // レート制限カウンタ（searchRoute等の不正利用対策、`functions/src/rateLimiting.js`参照）。
    // Cloud Functions（Admin SDK、本ルールの制約を受けない）のみが読み書きする。
    // クライアントから直接読めてしまうと、他ユーザーの呼び出し状況が推測できてしまうため拒否する。
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // お知らせ（設計書Step7）。運用者のみが管理コンソール等から作成し、
    // 作成をトリガーにCloud Functions（onAnnouncementCreated）がFCM配信する
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
